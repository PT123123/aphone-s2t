<?xml version="1.0" encoding="utf-8"?>
<!-- 录音主按钮的图标色：跟随背景色（primary / error）保证对比度 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="?attr/colorOnSurfaceVariant" />
    <item android:state_checked="true" android:color="?attr/colorOnError" />
    <item android:color="?attr/colorOnPrimary" />
</selector>
